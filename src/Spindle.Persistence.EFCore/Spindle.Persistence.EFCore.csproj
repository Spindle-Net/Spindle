<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>EntityFrameworkCore persistence provider for Spindle.Net.</Description>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Spindle.Abstractions\Spindle.Abstractions.csproj" />
      <ProjectReference Include="..\Spindle.Persistence.Abstractions\Spindle.Persistence.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational">
        <Version>10.0.10</Version>
      </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational">
        <Version>8.0.29</Version>
      </PackageReference>
    </ItemGroup>

</Project>
